import 'package:flutter/material.dart';

class BurnEffectWidget extends StatefulWidget {
  final Widget child;
  final AnimationController controller;

  const BurnEffectWidget({
    Key? key,
    required this.child,
    required this.controller,
  }) : super(key: key);

  @override
  State<BurnEffectWidget> createState() => _BurnEffectWidgetState();
}

class _BurnEffectWidgetState extends State<BurnEffectWidget> {
  late final Animation<double> _animation;

  @override
  void initState() {
    super.initState();
    _animation = CurvedAnimation(
      parent: widget.controller,
      curve: Curves.easeInOut,
    );
  }

  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _animation,
      builder: (context, child) {
        return Opacity(
          opacity: (1.0 - _animation.value).clamp(0.0, 1.0),
          child: Transform.translate(
            offset: Offset(_animation.value * 40, 0),
            child: ClipRect(
              child: Align(
                alignment: Alignment.centerRight,
                widthFactor: (1.0 - _animation.value),
                child: child,
              ),
            ),
          ),
        );
      },
      child: widget.child,
    );
  }
}
